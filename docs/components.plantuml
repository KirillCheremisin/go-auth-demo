@startuml Auth Demo Components
skinparam defaultFontName Arial
skinparam roundcorner 10
skinparam shadowing false

title "Auth Demo - Project Structure"

component "main.go" as Main
component "config.go" as Config
component "auth.go" as AuthHandler

package "grpc" {
  component "server.go" as GRPCServer
  component "user_service.go" as UserService
  component "user_service.proto" as Proto
  component "user_service.pb.go" as PBGo
  component "user_service_grpc.pb.go" as GRPCPBGo
}

package "auth" {
  component "session_manager.go" as SessionManager
  component "session_interface.go" as SessionInterface
  component "redis_session_store.go" as RedisStore
  component "jwt.go" as JWTManager
}

package "storage" {
  component "postgres.go" as PostgresStorage
  component "redis_session.go" as RedisSessionStorage
}

database "PostgreSQL" as PostgreSQL {
  component "users" as UsersTable
  component "refresh_tokens" as RefreshTokensTable
}

database "Redis" as Redis {
  component "session:*" as SessionKeys
}

' === Connections ===

Main --> Config
Main --> AuthHandler
Main --> GRPCServer
Main --> SessionManager

AuthHandler --> SessionManager
AuthHandler --> JWTManager
AuthHandler --> PostgresStorage

SessionManager --> RedisStore
RedisStore --> RedisSessionStorage
SessionInterface --> SessionManager

GRPCServer --> UserService
UserService --> PostgresStorage
UserService --> Proto
Proto --> PBGo
Proto --> GRPCPBGo

PostgresStorage --> PostgreSQL
RedisSessionStorage --> Redis

PostgresStorage --> UsersTable
PostgresStorage --> RefreshTokensTable
RedisSessionStorage --> SessionKeys

component "go.mod" as GoMod
component ".env" as Env
component "generate_proto.bat" as GenerateProto
component "README.md" as Readme

GoMod --> Main
Env --> Config
GenerateProto --> Proto

note right of Main
  Application entry point
  Starts HTTP (:8080) + gRPC (:50051)
  Graceful shutdown
  Initializes all components
end note

note left of SessionManager
  Uses: SessionManager struct
  Manages: UniversalSession
  Redis-only sessions
  24h expiration
end note

note right of AuthHandler
  Uses: AuthHandler struct
  HTTP endpoints:
  • POST /register
  • POST /login (session)
  • POST /login-jwt (token)
  • POST /refresh-token
  • GET  /session/profile
  • GET  /jwt/profile
  • POST /session/logout
  • GET  /session/users
end note

note bottom of PostgresStorage
  Uses: PostgresStorage struct
  Implements: Storage interface
  Methods: CreateUser, GetUserByID,
  VerifyPassword, StoreRefreshToken
end note

note right of RedisSessionStorage
  Uses: RedisSessionStorage struct
  Methods: StoreSession, GetSession,
  DeleteSession
  Keys: session:*
end note

@enduml